# Delivery settings — copy to .env and fill in, or export in your environment.
# All are OPTIONAL: with none set, `python src/main.py --no-send` still works
# and just writes the .bin into out/.

# Primary path: an n8n (or any) webhook that forwards the file to Telegram.
# It receives multipart form fields: secret, caption, type=file, document=<file>.
DISPATCH_URL=
DISPATCH_SECRET=

# Fallback path: a direct Telegram bot. If TG_BOT_TOKEN is set it is used
# instead of the dispatcher, sending straight to TG_CHAT_ID.
TG_BOT_TOKEN=
TG_CHAT_ID=
